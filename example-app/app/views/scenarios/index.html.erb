<% content_for :title, "Scenarios" %>
<% content_for :head do %>
  <%= javascript_include_tag "scenarios", defer: true %>
<% end %>

<h1>Scenarios</h1>

<p class="lede">
  The traffic shapes the Reader exists to make readable, one button each. Every button below
  is also a <code>curl</code> line — see the example app README for the exact ones. This
  page's own requests are not excluded from capture.
</p>

<ul class="scenarios">
  <% @scenarios.each do |scenario| %>
    <li>
      <button type="button" data-scenario="<%= scenario.path %>" data-count="<%= scenario.count %>">
        <%= scenario.label %>
      </button>
      <p class="meta"><%= scenario.description %></p>
    </li>
  <% end %>
</ul>

<p id="scenario-output" role="status"></p>

<h2>Process lifecycle Scenarios</h2>

<p class="lede">
  These press on process lifetime rather than traffic shape (#31), so none of them is a
  button: each one starts or kills the server itself, or needs an env var set before it
  boots, rather than sending it one more request. Copy a command into a terminal from
  inside the Example app root.
</p>

<ul class="scenarios scenario-commands">
  <% @scenario_commands.each do |scenario| %>
    <li>
      <p class="meta"><strong><%= scenario.label %></strong> — <%= scenario.description %></p>
      <pre><code><%= scenario.command %></code></pre>
    </li>
  <% end %>
</ul>
